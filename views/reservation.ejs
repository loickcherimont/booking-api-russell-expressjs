<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réservation</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
      <h1><a class="navbar-brand" href="/dashboard">API Catways</a></h1>
      <div class="d-flex align-items-center gap-2">
        <a href="/api-docs" class="btn btn-outline-info btn-sm">Documentation API</a>
        <a href="/logout" class="btn btn-outline-light">Se déconnecter</a>
      </div>
        </div>
    </nav>

    <div class="container mt-4">
        <a href="/catways/<%= reservation.catwayNumber %>/reservations" class="btn btn-outline-secondary mb-3">&larr; Retour aux réservations</a>

        <div class="card">
            <div class="card-header">
                <h2 class="mb-0">Réservation — Catway n°<%= reservation.catwayNumber %></h2>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Catway</dt>
                    <dd class="col-sm-9"><%= reservation.catwayNumber %></dd>

                    <dt class="col-sm-3">Client</dt>
                    <dd class="col-sm-9"><%= reservation.clientName %></dd>

                    <dt class="col-sm-3">Bateau</dt>
                    <dd class="col-sm-9"><%= reservation.boatName %></dd>

                    <dt class="col-sm-3">Début</dt>
                    <dd class="col-sm-9"><%= reservation.startDate.toLocaleDateString("fr-FR", { weekday: "long", year: "numeric", month: "long", day: "numeric" }) %></dd>

                    <dt class="col-sm-3">Fin</dt>
                    <dd class="col-sm-9"><%= reservation.endDate.toLocaleDateString("fr-FR", { weekday: "long", year: "numeric", month: "long", day: "numeric" }) %></dd>
                </dl>

                <hr>
                <h5>Modifier la réservation</h5>
                <form action="/catways/<%= reservation.catwayNumber %>/reservations/<%= reservation._id %>/update" method="POST">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="clientName" class="form-label">Client</label>
                            <input type="text" class="form-control" id="clientName" name="clientName" value="<%= reservation.clientName %>">
                        </div>
                        <div class="col-md-3">
                            <label for="boatName" class="form-label">Bateau</label>
                            <input type="text" class="form-control" id="boatName" name="boatName" value="<%= reservation.boatName %>">
                        </div>
                        <div class="col-md-2">
                            <label for="startDate" class="form-label">Début</label>
                            <input type="date" class="form-control" id="startDate" name="startDate" value="<%= reservation.startDate.toISOString().split('T')[0] %>">
                        </div>
                        <div class="col-md-2">
                            <label for="endDate" class="form-label">Fin</label>
                            <input type="date" class="form-control" id="endDate" name="endDate" value="<%= reservation.endDate.toISOString().split('T')[0] %>">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-warning w-100">Modifier</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-footer d-flex gap-2">
                <button class="btn btn-danger" onclick="deleteReservation()">Supprimer</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    <script>
        async function deleteReservation() {
            if (confirm("Confirmer la suppression de cette réservation ?")) {
                await fetch("/catways/<%= reservation.catwayNumber %>/reservations/<%= reservation._id %>", { method: "DELETE" });
                window.location.href = "/catways/<%= reservation.catwayNumber %>/reservations";
            }
        }
    </script>
</body>

</html>
