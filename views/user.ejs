<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Utilisateur <%= user.email %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
      <h1><a class="navbar-brand" href="/dashboard">API Catways</a></h1>
      <div class="d-flex align-items-center gap-2">
        <a href="/api-docs" class="btn btn-outline-info btn-sm">Documentation API</a>
        <a href="/logout" class="btn btn-outline-light">Se déconnecter</a>
      </div>
        </div>
    </nav>

    <div class="container mt-4">
        <a href="/users" class="btn btn-outline-secondary mb-3">&larr; Retour aux utilisateurs</a>

        <div class="card">
            <div class="card-header">
                <h2 class="mb-0"><%= user.username %></h2>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9"><%= user.email %></dd>

                    <dt class="col-sm-3">Nom d'utilisateur</dt>
                    <dd class="col-sm-9"><%= user.username %></dd>

                    <dt class="col-sm-3">Membre depuis</dt>
                    <dd class="col-sm-9"><%= user.createdAt %></dd>
                </dl>

                <hr>
                <h5>Modifier l'utilisateur</h5>
                <form action="/users/<%= user.email %>/update" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" value="<%= user.email %>">
                        </div>
                        <div class="col-md-3">
                            <label for="username" class="form-label">Nom d'utilisateur</label>
                            <input type="text" class="form-control" id="username" name="username" value="<%= user.username %>">
                        </div>
                        <div class="col-md-3">
                            <label for="password" class="form-label">Nouveau mot de passe</label>
                            <input type="password" class="form-control" id="password" name="password" placeholder="Laisser vide pour conserver">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-warning w-100">Modifier</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-footer d-flex gap-2">
                <button class="btn btn-danger" onclick="deleteUser()">Supprimer</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    <script>
        async function deleteUser() {
            if (confirm("Confirmer la suppression de <%= user.email %> ?")) {
                await fetch("/users/<%= encodeURIComponent(user.email) %>", { method: "DELETE" });
                window.location.href = "/users";
            }
        }
    </script>
</body>

</html>
