<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des catways</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
      <h1><a class="navbar-brand" href="/dashboard">API Catways</a></h1>
      <div class="d-flex align-items-center gap-2">
        <a href="/api-docs" class="btn btn-outline-info btn-sm">Documentation API</a>
        <a href="/logout" class="btn btn-outline-light">Se déconnecter</a>
      </div>
        </div>
    </nav>

    <div class="container mt-4">
        <h2>Catways</h2>

        <div class="card mt-4">
            <div class="card-header">Ajouter un catway</div>
            <div class="card-body">
                <form action="/catways" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="catwayType" class="form-label">Type</label>
                            <select class="form-select" id="catwayType" name="catwayType" required>
                                <option value="">Choisir...</option>
                                <option value="long">Long</option>
                                <option value="short">Short</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="catwayState" class="form-label">État</label>
                            <input type="text" class="form-control" id="catwayState" name="catwayState"
                                placeholder="Disponible, en maintenance...">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">Ajouter</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <table class="table table-striped mt-4">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>État</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% catways.forEach(catway=> { %>
                    <tr>
                        <td>
                            <%= catway.catwayNumber %>
                        </td>
                        <td>
                            <%= catway.catwayType %>
                        </td>
                        <td>
                            <%= catway.catwayState %>
                        </td>
                        <td>
                            <a href="/catways/<%= catway.catwayNumber %>" class="btn btn-sm btn-info">Consulter</a>
                            <button class="btn btn-sm btn-danger"
                                onclick="deleteCatwayByCatwayNumber(<%= catway.catwayNumber %>)">Supprimer</button>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
    <script>
        async function deleteCatwayByCatwayNumber(catwayNumber) {
            await fetch(`/catways/${catwayNumber}`, {
                method: "DELETE",
            });
            location.reload();
        }
    </script>
</body>

</html>